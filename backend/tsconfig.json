{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "@prisma/client": [
        "./node_modules/@prisma/client"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/test/**/*",
    "src/tests/**/*",
    "src/**/*.test.ts",
    "src/check-depts.ts",
    "src/test_api.ts"
  ]
}