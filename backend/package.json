{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "prisma generate --schema ./prisma/schema.prisma && tsx watch src/index.ts",
    "build": "npx prisma generate && npx tsc",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.1.0",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prisma": "^5.0.0",
    "socket.io": "^4.8.3",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.5",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6",
    "vitest": "^4.1.0",
    "eslint": "^8.45.0",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/bootstrap.ts"
  }
}
