generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                 @id @default(uuid())
  idNumber                  String                 @unique
  dob                       DateTime
  gender                    String?
  name                      String
  avatarUrl                 String?
  membershipNumber          String                 @unique
  membershipNumberUpdatedAt DateTime?
  status                    String                 @default("PENDING")
  role                      String                 @default("MEMBER")
  departmentId              String?
  phoneNumber               String?
  profilePhoto              String?
  deletionRequested         Boolean                @default(false)
  authenticatedAt           DateTime?
  authenticatedById         String?
  wrongdoingCount           Int                    @default(0)
  isSuspended               Boolean                @default(false)
  lastSuspendedAt           DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  isCardPaid                Boolean                @default(false)
  isPartner                 Boolean                @default(false)
  announcements             Announcement[]
  announcementApprovals     AnnouncementApproval[]
  auditLogs                 AuditLog[]
  baptisms                  Baptism[]              @relation("UserBaptisms")
  children                  Child[]                @relation("ParentChildren")
  devotionInteractions      DevotionInteraction[]
  eventApprovals            EventApproval[]
  assignedFollowUps         Meeting[]              @relation("MeetingFollowUp")
  meetingsOrganized         Meeting[]              @relation("MeetingOrganizer")
  meetingApprovals          MeetingApproval[]
  receivedMessages          Message[]              @relation("MessageReceiver")
  sentMessages              Message[]              @relation("MessageSender")
  notifications             Notification[]
  partnerships              Partnership[]          @relation("UserPartnerships")
  planApprovals             PlanApproval[]
  projectApprovals          ProjectApproval[]
  supportRequests           SupportRequest[]
  permissionOverrides       PermissionOverride[]   @relation("UserOverrides")
  transactionsApproved      Transaction[]          @relation("TransactionApprover")
  transactionsRequested     Transaction[]          @relation("TransactionRequester")
  authenticator             User?                  @relation("UserAuthenticator", fields: [authenticatedById], references: [id])
  authenticatedUsers        User[]                 @relation("UserAuthenticator")
  department                Department?            @relation("DeptLeader", fields: [departmentId], references: [id])
  managedDepartments        Department[]           @relation("DeptManagers")

  appointmentsByMember     Appointment[]          @relation("MemberAppointments")
  appointmentsAsTarget     Appointment[]          @relation("TargetAppointments")

  @@index([name])
  @@index([status])
  @@index([departmentId])
  @@index([role])
  @@index([dob])
  @@index([gender])
}

model Child {
  id                   String      @id @default(uuid())
  name                 String
  dob                  DateTime
  gender               String
  dedicationNumber     String?     @unique
  parentId             String
  departmentId         String?
  branch               String      @default("HQ")
  status               String      @default("ACTIVE")
  workflowStatus       String      @default("PENDING_DEDICATION")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  dedicationCardNumber String?
  isDedicated          Boolean     @default(false)
  plannedDate          DateTime?
  plannedTime          String?
  department           Department? @relation(fields: [departmentId], references: [id])
  parent               User        @relation("ParentChildren", fields: [parentId], references: [id])

  @@unique([name, dob, branch])
  @@index([name])
  @@index([workflowStatus])
  @@index([parentId])
  @@index([departmentId])
  @@index([branch])
  @@index([dob])
}

model Devotion {
  id           String                @id @default(uuid())
  title        String
  content      String
  themeOfMonth String
  themeOfYear  String
  date         DateTime              @unique @default(now())
  createdAt    DateTime              @default(now())
  interactions DevotionInteraction[]
}

model DevotionInteraction {
  id         String   @id @default(uuid())
  devotionId String
  userId     String
  type       String
  value      String
  createdAt  DateTime @default(now())
  devotion   Devotion @relation(fields: [devotionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([devotionId])
  @@index([userId])
}

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  leaderId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  account       Account?
  announcements Announcement[]
  children      Child[]
  events        Event[]
  meetings      Meeting[]
  messages      Message[]
  plans         Plan[]
  projects      Project[]
  leaders       User[]         @relation("DeptLeader")
  volunteers    Volunteer[]
  managers      User[]         @relation("DeptManagers")
}

model Event {
  id                String           @id @default(uuid())
  title             String
  description       String
  date              DateTime
  time              String
  location          String
  departmentId      String
  budgetNeeded      Float            @default(0)
  volunteersNeeded  Int              @default(0)
  eventType         String           @default("DEPARTMENT_EVENT")
  status            String           @default("PLANNED")
  isMajor           Boolean          @default(false)
  approvalStatus    String           @default("PENDING_APPROVAL")
  whatsappGroupLink String?
  attachmentUrl     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  department        Department       @relation(fields: [departmentId], references: [id])
  approvals         EventApproval[]
  messages          Message[]
  supportRequests   SupportRequest[]

  @@index([status])
  @@index([approvalStatus])
  @@index([departmentId])
}

model Meeting {
  id               String            @id @default(uuid())
  title            String
  departmentId     String
  date             DateTime
  time             String
  venue            String
  meetingType      String
  agenda           String
  organizerId      String
  followUpPersonId String?
  followUpDeadline DateTime?
  followUpStatus   String            @default("PENDING")
  meetingStatus    String            @default("PENDING_APPROVAL")
  minutes          String?
  attendance       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPartnerOnly    Boolean           @default(false)
  department       Department        @relation(fields: [departmentId], references: [id])
  followUpPerson   User?             @relation("MeetingFollowUp", fields: [followUpPersonId], references: [id])
  organizer        User              @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  approvals        MeetingApproval[]
}

model Announcement {
  id           String                 @id @default(uuid())
  title        String
  content      String
  priority     String                 @default("NORMAL")
  isGlobal     Boolean                @default(false)
  status       String                 @default("PENDING")
  expiry       DateTime?
  authorId     String
  departmentId String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  isMajor      Boolean                @default(false)
  author       User                   @relation(fields: [authorId], references: [id])
  department   Department?            @relation(fields: [departmentId], references: [id])
  approvals    AnnouncementApproval[]

  @@index([status])
  @@index([departmentId])
  @@index([isGlobal])
  @@index([isMajor])
}

model Volunteer {
  id           String     @id @default(uuid())
  name         String
  email        String?
  skills       String?
  availability String?
  departmentId String
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
}

model Project {
  id                String            @id @default(uuid())
  title             String
  description       String
  deadline          DateTime?
  departmentId      String
  status            String            @default("PLANNED")
  budget            Float             @default(0)
  progress          Int               @default(0)
  whatsappGroupLink String?
  approvalStatus    String            @default("PENDING_APPROVAL")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isMajor           Boolean           @default(false)
  messages          Message[]
  department        Department        @relation(fields: [departmentId], references: [id])
  approvals         ProjectApproval[]
  updates           ProjectUpdate[]

  @@index([status])
  @@index([approvalStatus])
  @@index([departmentId])
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  message   String
  date      DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Plan {
  id             String         @id @default(uuid())
  departmentId   String
  type           String
  title          String
  description    String
  approvalStatus String         @default("PENDING_APPROVAL")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isMajor        Boolean        @default(false)
  department     Department     @relation(fields: [departmentId], references: [id])
  approvals      PlanApproval[]

  @@index([approvalStatus])
  @@index([departmentId])
}

model Message {
  id           String      @id @default(uuid())
  content      String
  senderId     String
  receiverId   String?
  departmentId String?
  projectId    String?
  eventId      String?
  isEdited     Boolean     @default(false)
  isDeleted    Boolean     @default(false)
  isFlagged    Boolean     @default(false)
  flagReason   String?
  chatType     String      @default("DEPARTMENT")
  createdAt    DateTime    @default(now())
  department   Department? @relation(fields: [departmentId], references: [id])
  event        Event?      @relation(fields: [eventId], references: [id])
  project      Project?    @relation(fields: [projectId], references: [id])
  receiver     User?       @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender       User        @relation("MessageSender", fields: [senderId], references: [id])
}

model Account {
  id               String        @id @default(uuid())
  departmentId     String        @unique
  balance          Float         @default(0)
  totalIncome      Float         @default(0)
  totalExpenditure Float         @default(0)
  updatedAt        DateTime      @updatedAt
  department       Department    @relation(fields: [departmentId], references: [id])
  transactions     Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  accountId     String
  type          String
  amount        Float
  description   String
  status        String   @default("PENDING")
  requestedById String
  approvedById  String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  account       Account  @relation(fields: [accountId], references: [id])
  approver      User?    @relation("TransactionApprover", fields: [approvedById], references: [id])
  requester     User     @relation("TransactionRequester", fields: [requestedById], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model MeetingApproval {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  role      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

model AnnouncementApproval {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model SupportRequest {
  id             String   @id @default(uuid())
  eventId        String
  requesterId    String
  title          String
  description    String
  amountRequired Float    @default(1500)
  proofImageUrl  String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id])
  requester      User     @relation(fields: [requesterId], references: [id])
}

model EventApproval {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model ProjectApproval {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model PlanApproval {
  id        String   @id @default(uuid())
  planId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([planId, userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityId   String?
  entityType String?
  details    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType])
  @@index([createdAt])
  @@index([userId])
}

model Baptism {
  id         String    @id @default(uuid())
  userId     String
  status     String    @default("PENDING_PASTOR_APPROVAL")
  recordedAt DateTime?
  notes      String?
  plannedDate DateTime?
  plannedTime String?
  baptismCardNumber String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation("UserBaptisms", fields: [userId], references: [id])
}

model MinistrySettings {
  id           String   @id @default("GLOBAL")
  themeOfYear  String   @default("YEAR OF DIVINE ESTABLISHMENT")
  themeOfMonth String   @default("MONTH OF NEW BEGINNINGS")
  updatedAt    DateTime @updatedAt
  churchBudget Float    @default(0)
}

model Affirmation {
  id        String   @id @default(uuid())
  content   String
  date      DateTime @unique @default(now())
  createdAt DateTime @default(now())
}

model Partnership {
  id              String    @id @default(uuid())
  userId          String
  amount          Float     // Committed/Enrollment Amount
  paidAmount      Float     @default(0)
  balance         Float     @default(0)
  lastPaymentDate DateTime?
  frequency       String    @default("MONTHLY")
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation("UserPartnerships", fields: [userId], references: [id])

  @@index([userId])
}

model Appointment {
  id            String   @id @default(uuid())
  memberId      String
  member        User     @relation("MemberAppointments", fields: [memberId], references: [id])
  targetId      String?  // Optional: specific pastor/bishop
  target        User?    @relation("TargetAppointments", fields: [targetId], references: [id])
  targetRole    String   // BISHOP, PASTOR, ASSOCIATE_PASTOR
  type          String   // PRAYER, MEETING, COUNSELING, DELIVERANCE
  reason        String
  status        String   @default("PENDING") // PENDING, APPROVED, COMPLETED, CANCELLED
  preferredDate DateTime
  preferredTime String
  approvedDate  DateTime?
  approvedTime  String?
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([memberId])
  @@index([targetId])
  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "SUPER_ADMIN"
  description String?
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., "VIEW_GLOBAL_STATS"
  description String?
  roles       RolePermission[]
  overrides   PermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model PermissionOverride {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true) // true = grant, false = revoke
  expiresAt    DateTime?
  reason       String?
  creatorId    String
  user         User       @relation("UserOverrides", fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
}
