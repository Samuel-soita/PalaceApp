generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  idNumber              String                 @unique
  dob                   DateTime
  gender                String?
  password              String
  name                  String
  avatarUrl             String?
  membershipNumber      String?                @unique
  membershipNumberUpdatedAt DateTime?
  status                String                 @default("PENDING")
  role                  String                 @default("MEMBER")
  departmentId          String?
  wrongdoingCount       Int                    @default(0)
  isSuspended           Boolean                @default(false)
  lastSuspendedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  announcements         Announcement[]
  announcementApprovals AnnouncementApproval[]
  auditLogs             AuditLog[]
  eventApprovals        EventApproval[]
  meetingsOrganized     Meeting[]              @relation("MeetingOrganizer")
  assignedFollowUps     Meeting[]              @relation("MeetingFollowUp")
  meetingApprovals      MeetingApproval[]
  receivedMessages      Message[]              @relation("MessageReceiver")
  sentMessages          Message[]              @relation("MessageSender")
  notifications         Notification[]
  planApprovals         PlanApproval[]
  projectApprovals      ProjectApproval[]
  supportRequests       SupportRequest[]
  transactionsApproved  Transaction[]          @relation("TransactionApprover")
  transactionsRequested Transaction[]          @relation("TransactionRequester")
  department            Department?            @relation("DeptLeader", fields: [departmentId], references: [id])
}

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  leaderId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  account       Account?
  announcements Announcement[]
  assets        Asset[]
  budgets       Budget[]
  contributors  Contributor[]
  events        Event[]
  meetings      Meeting[]
  messages      Message[]
  plans         Plan[]
  projects      Project[]
  strategies    Strategy[]
  leaders       User[]         @relation("DeptLeader")
  volunteers    Volunteer[]
}

model Event {
  id                String           @id @default(uuid())
  title             String
  description       String
  date              DateTime
  time              String
  location          String
  departmentId      String
  budgetNeeded      Float            @default(0)
  volunteersNeeded  Int              @default(0)
  eventType         String           @default("DEPARTMENT_EVENT")
  status            String           @default("PLANNED")
  isMajor           Boolean          @default(false)
  approvalStatus    String           @default("PENDING_APPROVAL")
  whatsappGroupLink String?
  attachmentUrl     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  department        Department       @relation(fields: [departmentId], references: [id])
  approvals         EventApproval[]
  messages          Message[]
  supportRequests   SupportRequest[]
}

model Meeting {
  id               String            @id @default(uuid())
  title            String
  departmentId     String
  date             DateTime
  time             String
  venue            String
  meetingType      String
  agenda           String
  organizerId      String
  followUpPersonId String?
  followUpDeadline DateTime?
  followUpStatus   String            @default("PENDING")
  meetingStatus    String            @default("PENDING_APPROVAL")
  minutes          String?
  attendance       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  department       Department        @relation(fields: [departmentId], references: [id])
  organizer        User              @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  followUpPerson   User?             @relation("MeetingFollowUp", fields: [followUpPersonId], references: [id])
  approvals        MeetingApproval[]
}

model Budget {
  id                String        @id @default(uuid())
  title             String
  targetAmount      Float
  amountRaised      Float         @default(0)
  linkedEventId     String?
  deadline          DateTime
  status            String        @default("OPEN")
  departmentId      String?
  whatsappGroupLink String?
  isGlobal          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  department        Department?   @relation(fields: [departmentId], references: [id])
  contributors      Contributor[]
}

model Contributor {
  id            String      @id @default(uuid())
  name          String
  amount        Float
  paymentMethod String
  date          DateTime    @default(now())
  budgetId      String
  departmentId  String?
  anonymousFlag Boolean     @default(false)
  notes         String?
  budget        Budget      @relation(fields: [budgetId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
}

model Announcement {
  id           String                 @id @default(uuid())
  title        String
  content      String
  priority     String                 @default("NORMAL")
  isGlobal     Boolean                @default(false)
  status       String                 @default("PENDING")
  expiry       DateTime?
  authorId     String
  departmentId String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  isMajor      Boolean                @default(false)
  author       User                   @relation(fields: [authorId], references: [id])
  department   Department?            @relation(fields: [departmentId], references: [id])
  approvals    AnnouncementApproval[]
}


model Volunteer {
  id           String     @id @default(uuid())
  name         String
  email        String?
  skills       String?
  availability String?
  departmentId String
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
}

model Asset {
  id                  String     @id @default(uuid())
  name                String
  condition           String
  assignedTo          String?
  maintenanceSchedule String?
  departmentId        String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  department          Department @relation(fields: [departmentId], references: [id])
}

model Strategy {
  id             String     @id @default(uuid())
  title          String
  actionItems    String
  assignedPerson String?
  deadline       DateTime?
  status         String     @default("PENDING")
  departmentId   String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  department     Department @relation(fields: [departmentId], references: [id])
}

model Project {
  id                String            @id @default(uuid())
  title             String
  description       String
  deadline          DateTime?
  departmentId      String
  status            String            @default("PLANNED")
  budget            Float             @default(0)
  progress          Int               @default(0)
  whatsappGroupLink String?
  approvalStatus    String            @default("PENDING_APPROVAL")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isMajor           Boolean           @default(false)
  messages          Message[]
  department        Department        @relation(fields: [departmentId], references: [id])
  approvals         ProjectApproval[]
  updates           ProjectUpdate[]
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  message   String
  date      DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model Plan {
  id             String         @id @default(uuid())
  departmentId   String
  type           String
  title          String
  description    String
  approvalStatus String         @default("PENDING_APPROVAL")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isMajor        Boolean        @default(false)
  department     Department     @relation(fields: [departmentId], references: [id])
  approvals      PlanApproval[]
}

model Message {
  id           String      @id @default(uuid())
  content      String
  senderId     String
  receiverId   String?
  departmentId String?
  projectId    String?
  eventId      String?
  isEdited     Boolean     @default(false)
  isDeleted    Boolean     @default(false)
  isFlagged    Boolean     @default(false)
  flagReason   String?
  chatType     String      @default("DEPARTMENT")
  createdAt    DateTime    @default(now())
  event        Event?      @relation(fields: [eventId], references: [id])
  project      Project?    @relation(fields: [projectId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  receiver     User?       @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender       User        @relation("MessageSender", fields: [senderId], references: [id])
}

model Account {
  id               String        @id @default(uuid())
  departmentId     String        @unique
  balance          Float         @default(0)
  totalIncome      Float         @default(0)
  totalExpenditure Float         @default(0)
  updatedAt        DateTime      @updatedAt
  department       Department    @relation(fields: [departmentId], references: [id])
  transactions     Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  accountId     String
  type          String
  amount        Float
  description   String
  status        String   @default("PENDING")
  requestedById String
  approvedById  String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  approver      User?    @relation("TransactionApprover", fields: [approvedById], references: [id])
  requester     User     @relation("TransactionRequester", fields: [requestedById], references: [id])
  account       Account  @relation(fields: [accountId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model MeetingApproval {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  role      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  meeting   Meeting  @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, userId])
}

model AnnouncementApproval {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  announcement   Announcement @relation(fields: [announcementId], references: [id])

  @@unique([announcementId, userId])
}

model SupportRequest {
  id             String   @id @default(uuid())
  eventId        String
  requesterId    String
  title          String
  description    String
  amountRequired Float    @default(1500)
  proofImageUrl  String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  requester      User     @relation(fields: [requesterId], references: [id])
  event          Event    @relation(fields: [eventId], references: [id])
}

model EventApproval {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
}

model ProjectApproval {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, userId])
}

model PlanApproval {
  id        String   @id @default(uuid())
  planId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])

  @@unique([planId, userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityId   String?
  entityType String?
  details    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}
