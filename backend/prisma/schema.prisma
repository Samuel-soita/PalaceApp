generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                             String                 @id @default(uuid())
  idNumber                                       String                 @unique
  dob                                            DateTime
  gender                                         String?
  name                                           String
  avatarUrl                                      String?
  membershipNumber                               String                 @unique
  membershipNumberUpdatedAt                      DateTime?
  status                                         String                 @default("PENDING")
  role                                           String                 @default("MEMBER")
  departmentId                                   String?
  phoneNumber                                    String?
  profilePhoto                                   String?
  deletionRequested                              Boolean                @default(false)
  authenticatedAt                                DateTime?
  authenticatedById                              String?
  wrongdoingCount                                Int                    @default(0)
  isSuspended                                    Boolean                @default(false)
  lastSuspendedAt                                DateTime?
  createdAt                                      DateTime               @default(now())
  updatedAt                                      DateTime               @updatedAt
  isCardPaid                                     Boolean                @default(false)
  isPartner                                      Boolean                @default(false)
  canManagePartnerships                          Boolean                @default(false)
  deletedAt                                      DateTime?
  deletedBy                                      String?
  deletedReason                                  String?
  version                                        Int                    @default(0)
  cardStatus                                     String                 @default("ACTIVE")
  isCardReplacementRequested                     Boolean                @default(false)
  membershipExpiry                               DateTime?
  announcements                                  Announcement[]
  Announcement_Announcement_targetPastorIdToUser Announcement[]         @relation("Announcement_targetPastorIdToUser")
  announcementApprovals                          AnnouncementApproval[]
  appointmentsByMember                           Appointment[]          @relation("MemberAppointments")
  appointmentsAsTarget                           Appointment[]          @relation("TargetAppointments")
  auditLogs                                      AuditLog[]
  baptisms                                       Baptism[]              @relation("UserBaptisms")
  budgetContributions                            BudgetContributor[]
  assignedChildren                               Child[]                @relation("PastorAssignments")
  children                                       Child[]                @relation("ParentChildren")
  submittedReports                               DepartmentReport[]     @relation("ReportSubmitter")
  authoredDevotions                              Devotion[]             @relation("UserDevotions")
  devotionInteractions                           DevotionInteraction[]
  Event                                          Event[]
  eventApprovals                                 EventApproval[]
  assignedFollowUps                              Meeting[]              @relation("MeetingFollowUp")
  meetingsOrganized                              Meeting[]              @relation("MeetingOrganizer")
  Meeting_Meeting_targetPastorIdToUser           Meeting[]              @relation("Meeting_targetPastorIdToUser")
  meetingApprovals                               MeetingApproval[]
  receivedMessages                               Message[]              @relation("MessageReceiver")
  sentMessages                                   Message[]              @relation("MessageSender")
  notifications                                  Notification[]
  partnerships                                   Partnership[]          @relation("UserPartnerships")
  pastorModuleAccess                             PastorModuleAccess[]   @relation("PastorModulePermissions")
  permissionOverrides                            PermissionOverride[]   @relation("UserOverrides")
  Plan                                           Plan[]
  planApprovals                                  PlanApproval[]
  Project                                        Project[]
  projectApprovals                               ProjectApproval[]
  repairApprovals                                RepairApproval[]
  sessions                                       Session[]
  supportRequests                                SupportRequest[]
  requestedRepairs                               TechnicalRepair[]      @relation("RepairRequester")
  transactionsRequested                          Transaction[]          @relation("TransactionRequester")
  transactionApprovals                           TransactionApproval[]
  authenticator                                  User?                  @relation("UserAuthenticator", fields: [authenticatedById], references: [id])
  authenticatedUsers                             User[]                 @relation("UserAuthenticator")
  department                                     Department?            @relation("DeptLeader", fields: [departmentId], references: [id])
  managedDepartments                             Department[]           @relation("DeptManagers")
  taggedInMessages                               Message[]              @relation("MessageTags")

  @@index([name])
  @@index([status])
  @@index([departmentId])
  @@index([role])
  @@index([dob])
  @@index([gender])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Child {
  id                         String      @id @default(uuid())
  name                       String
  dob                        DateTime
  gender                     String
  dedicationNumber           String?     @unique
  parentId                   String
  departmentId               String?
  branch                     String      @default("HQ")
  status                     String      @default("ACTIVE")
  workflowStatus             String      @default("PENDING_DEDICATION")
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  dedicationCardNumber       String?
  isDedicated                Boolean     @default(false)
  plannedDate                DateTime?
  plannedTime                String?
  deletedAt                  DateTime?
  deletedBy                  String?
  deletedReason              String?
  version                    Int         @default(0)
  dedicationPaymentReference String?
  isDedicationPaid           Boolean     @default(false)
  assignedPastorId           String?
  assignedPastor             User?       @relation("PastorAssignments", fields: [assignedPastorId], references: [id])
  department                 Department? @relation(fields: [departmentId], references: [id])
  parent                     User        @relation("ParentChildren", fields: [parentId], references: [id])

  @@unique([name, dob, branch])
  @@index([name])
  @@index([workflowStatus])
  @@index([parentId])
  @@index([departmentId])
  @@index([branch])
  @@index([dob])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([assignedPastorId])
}

model Devotion {
  id           String                @id @default(uuid())
  title        String
  content      String
  themeOfMonth String
  themeOfYear  String
  date         DateTime              @unique @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt
  deletedAt    DateTime?
  version      Int                   @default(0)
  authorId     String?
  affirmations Affirmation[]
  author       User?                 @relation("UserDevotions", fields: [authorId], references: [id])
  interactions DevotionInteraction[]
}

model DevotionInteraction {
  id         String   @id @default(uuid())
  devotionId String
  userId     String
  type       String
  value      String
  createdAt  DateTime @default(now())
  devotion   Devotion @relation(fields: [devotionId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([devotionId])
  @@index([userId])
}

model Department {
  id            String             @id @default(uuid())
  name          String             @unique
  description   String?
  leaderId      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?
  version       Int                @default(0)
  account       Account?
  announcements Announcement[]
  budgets       Budget[]
  children      Child[]
  reports       DepartmentReport[]
  events        Event[]
  meetings      Meeting[]
  messages      Message[]
  plans         Plan[]
  projects      Project[]
  repairs       TechnicalRepair[]
  leaders       User[]             @relation("DeptLeader")
  managers      User[]             @relation("DeptManagers")

  @@index([deletedAt])
  @@index([updatedAt])
}

model Event {
  id                String           @id @default(uuid())
  title             String
  description       String
  date              DateTime
  time              String
  location          String
  departmentId      String
  budgetNeeded      Float            @default(0)
  budgetSource      String           @default("DEPARTMENT")
  volunteersNeeded  Int              @default(0)
  eventType         String           @default("DEPARTMENT_EVENT")
  status            String           @default("PLANNED")
  isMajor           Boolean          @default(false)
  approvalStatus    String           @default("PENDING_APPROVAL")
  whatsappGroupLink String?
  attachmentUrl     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  deletedReason     String?
  version           Int              @default(0)
  targetPastorId    String?
  department        Department       @relation(fields: [departmentId], references: [id])
  User              User?            @relation(fields: [targetPastorId], references: [id])
  approvals         EventApproval[]
  messages          Message[]
  supportRequests   SupportRequest[]

  @@index([status])
  @@index([approvalStatus])
  @@index([departmentId])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Meeting {
  id                                String            @id @default(uuid())
  title                             String
  departmentId                      String
  date                              DateTime
  time                              String
  venue                             String
  meetingType                       String
  agenda                            String
  organizerId                       String
  followUpPersonId                  String?
  followUpDeadline                  DateTime?
  followUpStatus                    String            @default("PENDING")
  meetingStatus                     String            @default("PENDING_APPROVAL")
  minutes                           String?
  attendance                        String?
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime          @updatedAt
  isPartnerOnly                     Boolean           @default(false)
  deletedAt                         DateTime?
  deletedBy                         String?
  deletedReason                     String?
  version                           Int               @default(0)
  targetPastorId                    String?
  department                        Department        @relation(fields: [departmentId], references: [id])
  followUpPerson                    User?             @relation("MeetingFollowUp", fields: [followUpPersonId], references: [id])
  organizer                         User              @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  User_Meeting_targetPastorIdToUser User?             @relation("Meeting_targetPastorIdToUser", fields: [targetPastorId], references: [id])
  approvals                         MeetingApproval[]

  @@index([deletedAt])
  @@index([updatedAt])
}

model Announcement {
  id                                     String                 @id @default(uuid())
  title                                  String
  content                                String
  priority                               String                 @default("NORMAL")
  isGlobal                               Boolean                @default(false)
  status                                 String                 @default("PENDING")
  expiry                                 DateTime?
  eventDate                              DateTime?
  eventTime                              String?
  location                               String?
  authorId                               String
  departmentId                           String?
  createdAt                              DateTime               @default(now())
  updatedAt                              DateTime               @updatedAt
  isMajor                                Boolean                @default(false)
  deletedAt                              DateTime?
  deletedBy                              String?
  deletedReason                          String?
  version                                Int                    @default(0)
  targetPastorId                         String?
  author                                 User                   @relation(fields: [authorId], references: [id])
  department                             Department?            @relation(fields: [departmentId], references: [id])
  User_Announcement_targetPastorIdToUser User?                  @relation("Announcement_targetPastorIdToUser", fields: [targetPastorId], references: [id])
  approvals                              AnnouncementApproval[]

  @@index([status])
  @@index([departmentId])
  @@index([isGlobal])
  @@index([isMajor])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Project {
  id                String            @id @default(uuid())
  title             String
  description       String
  deadline          DateTime?
  departmentId      String
  status            String            @default("PLANNED")
  category          String            @default("NEW_PROJECT")
  budget            Float             @default(0)
  budgetSource      String            @default("DEPARTMENT")
  progress          Int               @default(0)
  whatsappGroupLink String?
  approvalStatus    String            @default("PENDING_APPROVAL")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isMajor           Boolean           @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  deletedReason     String?
  version           Int               @default(0)
  targetPastorId    String?
  messages          Message[]
  department        Department        @relation(fields: [departmentId], references: [id])
  User              User?             @relation(fields: [targetPastorId], references: [id])
  approvals         ProjectApproval[]
  updates           ProjectUpdate[]

  @@index([status])
  @@index([approvalStatus])
  @@index([departmentId])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Plan {
  id             String         @id @default(uuid())
  departmentId   String
  type           String
  title          String
  content        String         @default("")
  budgetSource   String         @default("DEPARTMENT")
  approvalStatus String         @default("PENDING_APPROVAL")
  status         String         @default("PLANNED")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isMajor        Boolean        @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletedReason  String?
  version        Int            @default(0)
  targetPastorId String?
  department     Department     @relation(fields: [departmentId], references: [id])
  User           User?          @relation(fields: [targetPastorId], references: [id])
  approvals      PlanApproval[]

  @@index([approvalStatus])
  @@index([departmentId])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Message {
  id                  String      @id @default(uuid())
  content             String
  senderId            String
  receiverId          String?
  departmentId        String?
  projectId           String?
  eventId             String?
  isEdited            Boolean     @default(false)
  isDeleted           Boolean     @default(false)
  isFlagged           Boolean     @default(false)
  flagReason          String?
  chatType            String      @default("DEPARTMENT")
  createdAt           DateTime    @default(now())
  version             Int         @default(0)
  taggedDepartmentIds String[]    @default([])
  department          Department? @relation(fields: [departmentId], references: [id])
  event               Event?      @relation(fields: [eventId], references: [id])
  project             Project?    @relation(fields: [projectId], references: [id])
  receiver            User?       @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender              User        @relation("MessageSender", fields: [senderId], references: [id])
  taggedUsers         User[]      @relation("MessageTags")
}

model Account {
  id               String        @id @default(uuid())
  departmentId     String        @unique
  balance          Float         @default(0)
  totalIncome      Float         @default(0)
  totalExpenditure Float         @default(0)
  updatedAt        DateTime      @updatedAt
  version          Int           @default(0)
  deletedAt        DateTime?
  department       Department    @relation(fields: [departmentId], references: [id])
  transactions     Transaction[]
}

model Transaction {
  id            String                @id @default(uuid())
  accountId     String
  type          String
  amount        Float
  description   String
  status        String                @default("PENDING_LEADER_APPROVAL")
  requestedById String
  date          DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  version       Int                   @default(0)
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?
  account       Account               @relation(fields: [accountId], references: [id])
  requester     User                  @relation("TransactionRequester", fields: [requestedById], references: [id])
  approvals     TransactionApproval[]

  @@index([accountId])
  @@index([status])
  @@index([updatedAt])
}

model TransactionApproval {
  id            String      @id @default(uuid())
  transactionId String
  userId        String
  role          String
  approved      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
}

model Notification {
  id              String   @id @default(uuid())
  userId          String
  title           String
  message         String
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())
  attempts        Int      @default(0)
  deliveryChannel String   @default("IN_APP")
  status          String   @default("SENT")
  type            String   @default("SYSTEM")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model MeetingApproval {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  role      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

model AnnouncementApproval {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model SupportRequest {
  id             String   @id @default(uuid())
  eventId        String?
  requesterId    String
  title          String
  description    String
  amountRequired Float    @default(0)
  proofImageUrl  String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  adminReply     String?
  category       String   @default("EVENT_FUNDING")
  event          Event?   @relation(fields: [eventId], references: [id])
  requester      User     @relation(fields: [requesterId], references: [id])
}

model EventApproval {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

model ProjectApproval {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model PlanApproval {
  id        String   @id @default(uuid())
  planId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([planId, userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  entityId    String?
  entityType  String
  createdAt   DateTime @default(now())
  actionType  String
  actorId     String
  actorRole   String   @default("MEMBER")
  afterState  Json?
  beforeState Json?
  ipAddress   String?
  metadata    Json?
  userAgent   String?
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityId])
  @@index([createdAt])
  @@index([actionType])
}

model Baptism {
  id                String    @id @default(uuid())
  userId            String
  status            String    @default("PENDING_PASTOR_APPROVAL")
  recordedAt        DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  baptismCardNumber String?
  plannedDate       DateTime?
  plannedTime       String?
  deletedAt         DateTime?
  deletedBy         String?
  deletedReason     String?
  version           Int       @default(0)
  isPaid            Boolean   @default(false)
  paymentReference  String?
  user              User      @relation("UserBaptisms", fields: [userId], references: [id])

  @@index([deletedAt])
}

model Partnership {
  id              String              @id @default(uuid())
  userId          String
  amount          Float
  frequency       String              @default("MONTHLY")
  status          String              @default("ACTIVE")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  balance         Float               @default(0)
  lastPaymentDate DateTime?
  paidAmount      Float               @default(0)
  deletedAt       DateTime?
  deletedBy       String?
  deletedReason   String?
  version         Int                 @default(0)
  user            User                @relation("UserPartnerships", fields: [userId], references: [id])
  ledgers         PartnershipLedger[]

  @@index([userId])
  @@index([deletedAt])
  @@index([updatedAt])
}

model PartnershipLedger {
  id              String      @id @default(uuid())
  partnershipId   String
  amount          Float
  transactionType String      @default("CREDIT")
  paymentMethod   String      @default("MPESA")
  referenceCode   String      @unique
  status          String      @default("VERIFIED")
  date            DateTime    @default(now())
  createdAt       DateTime    @default(now())
  version         Int         @default(0)
  deletedAt       DateTime?
  deletedBy       String?
  deletedReason   String?
  updatedAt       DateTime    @updatedAt
  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Appointment {
  id            String    @id @default(uuid())
  memberId      String
  targetId      String?
  targetRole    String
  type          String
  reason        String
  status        String    @default("PENDING")
  preferredDate DateTime
  preferredTime String
  approvedDate  DateTime?
  approvedTime  String?
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?
  version       Int       @default(0)
  member        User      @relation("MemberAppointments", fields: [memberId], references: [id])
  target        User?     @relation("TargetAppointments", fields: [targetId], references: [id])

  @@index([memberId])
  @@index([targetId])
  @@index([status])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
}

model Permission {
  id          String               @id @default(uuid())
  code        String               @unique
  description String?
  overrides   PermissionOverride[]
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model PermissionOverride {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  expiresAt    DateTime?
  reason       String?
  creatorId    String
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User       @relation("UserOverrides", fields: [userId], references: [id])

  @@unique([userId, permissionId])
}

model JobQueue {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model SystemMetric {
  id              String   @id @default(uuid())
  latency         Float
  activeUsers     Int
  errorCount      Int
  failedJobs      Int
  wsConnections   Int
  pendingApproval Int
  createdAt       DateTime @default(now())
  failureRate     Float    @default(0)
  syncSuccessRate Float    @default(0)
}

model FeatureFlag {
  id        String   @id @default(uuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  scope     String   @default("GLOBAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PastorModuleAccess {
  id          String   @id @default(uuid())
  pastorId    String
  moduleKey   String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pastor      User     @relation("PastorModulePermissions", fields: [pastorId], references: [id], onDelete: Cascade)

  @@unique([pastorId, moduleKey])
}

model Budget {
  id            String              @id @default(uuid())
  title         String
  targetAmount  Float
  deadline      DateTime
  departmentId  String
  linkedEventId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  version       Int                 @default(0)
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?
  department    Department          @relation(fields: [departmentId], references: [id])
  contributors  BudgetContributor[]

  @@index([departmentId])
  @@index([deletedAt])
}

model BudgetContributor {
  id        String   @id @default(uuid())
  budgetId  String
  userId    String
  amount    Float
  createdAt DateTime @default(now())
  budget    Budget   @relation(fields: [budgetId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([budgetId])
  @@index([userId])
}

model DepartmentReport {
  id            String     @id @default(uuid())
  departmentId  String
  type          String
  content       String?
  fileUrl       String?
  fileName      String?
  submittedById String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  downloadedAt  DateTime?
  department    Department @relation(fields: [departmentId], references: [id])
  submittedBy   User       @relation("ReportSubmitter", fields: [submittedById], references: [id])

  @@index([departmentId])
  @@index([type])
}

model TechnicalRepair {
  id                 String           @id @default(uuid())
  departmentId       String
  instrumentName     String
  problemDescription String
  estimatedCost      Float
  budgetSource       String           @default("DEPARTMENT")
  status             String           @default("PENDING_PASTOR_1")
  requesterId        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  deletedBy          String?
  deletedReason      String?
  version            Int              @default(0)
  approvals          RepairApproval[]
  department         Department       @relation(fields: [departmentId], references: [id])
  requester          User             @relation("RepairRequester", fields: [requesterId], references: [id])

  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@index([updatedAt])
}

model RepairApproval {
  id        String          @id @default(uuid())
  repairId  String
  userId    String
  role      String
  approved  Boolean         @default(true)
  createdAt DateTime        @default(now())
  repair    TechnicalRepair @relation(fields: [repairId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@unique([repairId, userId])
}

model WatuaActionLog {
  id            String   @id @default(uuid())
  engineerId    String
  actionType    String
  targetEntity  String
  beforeState   Json?
  afterState    Json?
  approvalChain Json?
  executed      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model MinistrySettings {
  id           String   @id @default("GLOBAL")
  themeOfYear  String   @default("YEAR OF DIVINE ESTABLISHMENT")
  themeOfMonth String   @default("MONTH OF NEW BEGINNINGS")
  updatedAt    DateTime @updatedAt
  version      Int      @default(0)
}

model Affirmation {
  id         String    @id @default(uuid())
  content    String
  date       DateTime  @unique @default(now())
  createdAt  DateTime  @default(now())
  version    Int       @default(0)
  devotionId String?
  devotion   Devotion? @relation(fields: [devotionId], references: [id])
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  message   String
  date      DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}
